---
import Base from './Base.astro';
import VariantNav from '../components/VariantNav.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  lede?: string;
}

const { title, description, heading, lede } = Astro.props;
---

<Base title={title} description={description}>
  <article class="variant-doc">
    <p class="variant-kicker"><a href="/variants/">Storage forms</a></p>
    <h1>{heading}</h1>
    {lede && <p class="variant-lede">{lede}</p>}
    <VariantNav />
    <slot />
  </article>
</Base>

<style>
  .variant-kicker {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  .variant-kicker a {
    color: var(--color-muted);
  }
  .variant-doc h1 {
    margin-top: 0;
  }
  .variant-lede {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin-bottom: 0;
  }
  .variant-doc :global(.format-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .variant-doc :global(.format-card) {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem 1.15rem;
    background: var(--color-card-bg);
  }
  .variant-doc :global(.format-card h3) {
    margin-top: 0;
    font-size: 1rem;
  }
  .variant-doc :global(.format-card p) {
    font-size: 0.92rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .variant-doc :global(.badge) {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15em 0.5em;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  .variant-doc :global(.badge-stable) {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }
  .variant-doc :global(.badge-future) {
    background: var(--color-code-bg);
    color: var(--color-muted);
  }
</style>
