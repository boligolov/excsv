---
import Variant from '../../layouts/Variant.astro';
import CodeBlock from '../../components/CodeBlock.astro';
---

<Variant
  title="Plain ExCSV (inline)"
  description="The canonical ExCSV form: header, meta lines, and CSV data rows in one file."
  heading="Plain (inline)"
  lede="Header, metadata, and data rows live in one file. Any CSV tool can read the data section; ExCSV tools read everything."
>
  <h2>File layout</h2>
  <pre><code>#!excsv version=0.3 delim=comma header=1
#@source: analytics_db.events
#column name=id type=int
#column name=name type=string
id,name
1,Widget
2,Gadget</code></pre>

  <h2>Extensions</h2>
  <ul>
    <li><code>.excsv</code> — CSV dialect (inline or sidecar; default <code>delim=comma</code>)</li>
    <li><code>.extsv</code> — TSV dialect (inline or sidecar; <strong>SHOULD</strong> use <code>delim=tab</code>)</li>
  </ul>

  <h2>Profiles within plain</h2>
  <table>
    <thead>
      <tr><th>Profile</th><th>Data rows</th><th><code>reference=</code></th></tr>
    </thead>
    <tbody>
      <tr><td><strong>Inline</strong> (default)</td><td>yes</td><td>MUST NOT be set</td></tr>
      <tr><td><strong>Sidecar</strong></td><td>no</td><td>REQUIRED — see <a href="/variants/sidecar/">Sidecar</a></td></tr>
      <tr><td><strong>Header-only stub</strong></td><td>no</td><td>absent (templates, exports)</td></tr>
    </tbody>
  </table>

  <CodeBlock title="Minimal inline" description="Schema + two data rows.">
{`#!excsv version=0.3 delim=comma header=1
#column name=id type=int
#column name=name type=string
id,name
1,Widget
2,Gadget`}
  </CodeBlock>

  <p><a href="/examples/">More examples</a> · <a href="/spec/">Full specification</a></p>
</Variant>
